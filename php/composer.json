{
  "name": "spart/sdk",
  "description": "Official PHP SDK for the Spart payment-splitting platform.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "Spart\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Spart\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --no-coverage",
    "lint": "phpcs",
    "analyse": "phpstan analyse --no-progress --memory-limit=512M",
    "ci": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "minimum-stability": "stable"
}
